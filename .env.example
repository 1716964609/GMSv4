# Mock mode is safe for local development and tests.
TRANSLATION_PROVIDER=mock

# Local SQLite database path. SQLite files are ignored by Git.
DATABASE_URL=./data/gmsv4.sqlite

# Real provider settings. Keep real keys in .env.local or a deployment secret manager.
DEEPL_API_URL=https://api-free.deepl.com
DEEPL_API_KEY=replace-with-deepl-api-key
OPENAI_API_URL=https://api.openai.com
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-6-luna
# Optional; omit to use the provider default.
OPENAI_MAX_COMPLETION_TOKENS=4096
